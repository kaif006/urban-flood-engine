# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# C# and .NET files
[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

# Unity specific formatting overrides
[*.{shader,cginc,hlsl}]
indent_style = space
indent_size = 4
end_of_line = crlf

# Configuration files
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf
